{
  "name": "ts-playground",
  "version": "1.0.0",
  "description": "A learning journal for TypeScript concepts.",
  "private": true,
  "type": "module",
  "scripts": {
    "generics": "tsx src/generics/demo/index.ts",
    "generics:identity": "tsx src/generics/demo/identity.ts",
    "generics:filter-array": "tsx src/generics/demo/filterArray.ts",
    "generics:use-fetch": "tsx src/generics/demo/useFetch.ts",
    "generics:extract": "tsx src/generics/demo/extract.ts",
    "generics:return-type": "tsx src/generics/demo/returnType.ts",
    "generics:fetch-json": "tsx src/generics/demo/fetchJSON.ts",
    "utility-types": "tsx src/utility-types/demo/index.ts",
    "utility-types:partial": "tsx src/utility-types/demo/renderPost.ts",
    "utility-types:pick": "tsx src/utility-types/demo/renderSummaries.ts",
    "utility-types:mapped": "tsx src/utility-types/demo/mappedTypes.ts",
    "type-guards": "tsx src/type-guards/demo/index.ts",
    "type-guards:string": "tsx src/type-guards/demo/isString.ts",
    "type-guards:boolean": "tsx src/type-guards/demo/isBoolean.ts",
    "type-guards:admin": "tsx src/type-guards/demo/isAdmin.ts",
    "type-guards:payload": "tsx src/type-guards/demo/isCreateUserPayload.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}